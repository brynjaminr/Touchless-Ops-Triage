    },
    {
      "parameters": {
        "functionCode": "// NetSuite stub - implement with RESTlet or SuiteTalk\nreturn {\n  json: {\n    matched: false,\n    matchConfidence: 0,\n    exceptionReason: \"NetSuite integration pending\"\n  }\n};"
      },
      "id": "netsuite-stub",
      "name": "NetSuite Stub",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 600]
    },
    {
      "parameters": {
        "functionCode": "const invoiceData = $('Called by Extraction').item.json;\nconst poResult = $input.first().json;\n\nlet matched = false;\nlet matchConfidence = 0;\nlet exceptionReason = null;\nlet matchedPo = null;\n\nif (poResult && poResult.PurchaseOrders && poResult.PurchaseOrders.length > 0) {\n  const po = poResult.PurchaseOrders[0];\n  matchedPo = po.PurchaseOrderNumber;\n  \n  const amountMatch = Math.abs(parseFloat(po.Total) - invoiceData.totalAmount) < 0.01;\n  const vendorMatch = po.Contact.Name.toLowerCase().includes(invoiceData.vendorName.toLowerCase());\n  \n  if (amountMatch && vendorMatch) {\n    matchConfidence = 95;\n    matched = true;\n  } else if (amountMatch || vendorMatch) {\n    matchConfidence = 60;\n    exceptionReason = \"Partial PO match - review required\";\n  } else {\n    matchConfidence = 30;\n    exceptionReason = \"PO found but amount/vendor mismatch\";\n  }\n} else {\n  matchConfidence = 0;\n  exceptionReason = \"No matching PO found\";\n}\n\nreturn {\n  json: {\n    ...invoiceData,\n    matchConfidence,\n    matched,\n    matchedPo,\n    exceptionReason,\n    accountingSystem: 'xero'\n  }\n};"
      },
      "id": "calculate-match-xero",
      "name": "Calculate Match Confidence (Xero)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "functionCode": "const invoiceData = $('Called by Extraction').item.json;\nconst poResult = $input.first().json;\n\nlet matched = false;\nlet matchConfidence = 0;\nlet exceptionReason = null;\nlet matchedPo = null;\n\nif (poResult && poResult.QueryResponse && poResult.QueryResponse.PurchaseOrder && poResult.QueryResponse.PurchaseOrder.length > 0) {\n  const po = poResult.QueryResponse.PurchaseOrder[0];\n  matchedPo = po.DocNumber;\n  \n  const amountMatch = Math.abs(parseFloat(po.TotalAmt) - invoiceData.totalAmount) < 0.01;\n  const vendorMatch = po.VendorRef.name.toLowerCase().includes(invoiceData.vendorName.toLowerCase());\n  \n  if (amountMatch && vendorMatch) {\n    matchConfidence = 95;\n    matched = true;\n  } else if (amountMatch || vendorMatch) {\n    matchConfidence = 60;\n    exceptionReason = \"Partial PO match - review required\";\n  } else {\n    matchConfidence = 30;\n    exceptionReason = \"PO found but amount/vendor mismatch\";\n  }\n} else {\n  matchConfidence = 0;\n  exceptionReason = \"No matching PO found\";\n}\n\nreturn {\n  json: {\n    ...invoiceData,\n    matchConfidence,\n    matched,\n    matchedPo,\n    exceptionReason,\n    accountingSystem: 'quickbooks'\n  }\n};"
      },
      "id": "calculate-match-qbo",
      "name": "Calculate Match Confidence (QBO)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 400]
    },
