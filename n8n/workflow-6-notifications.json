{
  "name": "Notifications (Email + Slack + Teams)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      },
      "id": "poll-notifications",
      "name": "Poll Every 2 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{process.env.BACKEND_URL}}/api/notifications/pending",
        "options": {}
      },
      "id": "fetch-pending",
      "name": "Fetch Pending Notifications",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 400]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.length}}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "has-notifications",
      "name": "Has Notifications?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 400]
    },
    {
      "parameters": {
        "fieldToSplitOut": "=",
        "options": {}
      },
      "id": "split-notifications",
      "name": "Split Notifications",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.channel}}",
              "value2": "email"
            },
            {
              "value1": "={{$json.channel}}",
              "value2": "slack"
            },
            {
              "value1": "={{$json.channel}}",
              "value2": "teams"
            }
          ]
        },
        "combineOperation": "any"
      },
      "id": "route-by-channel",
      "name": "Route by Channel",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "fromEmail": "={{process.env.SMTP_FROM}}",
        "toEmail": "={{$json.recipient}}",
        "subject": "={{$json.subject}}",
        "emailType": "html",
        "message": "={{$json.message}}",
        "options": {}
      },
      "id": "send-email",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1250, 100]
    },
    {
      "parameters": {
        "channel": "={{$json.recipient}}",
        "text": "={{$json.subject}}",
        "otherOptions": {
          "blocks": "=[\n  {\n    \"type\": \"section\",\n    \"text\": {\n      \"type\": \"mrkdwn\",\n      \"text\": \"{{$json.message}}\"\n    }\n  }\n]"
        }
      },
      "id": "send-slack",
      "name": "Send Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "webhookUrl": "={{$json.recipient}}",
        "messageType": "message",
        "messageText": "={{$json.message}}",
        "options": {
          "title": "={{$json.subject}}"
        }
      },
      "id": "send-teams",
      "name": "Send Teams",
      "type": "n8n-nodes-base.microsoftTeams",
      "typeVersion": 1.1,
      "position": [1250, 500]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{process.env.BACKEND_URL}}/api/notifications/{{$json.id}}/sent",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={}",
        "options": {}
      },
      "id": "mark-sent",
      "name": "Mark as Sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1450, 300]
    },
    {
      "parameters": {
        "errorMessage": "={{$json.error}}"
      },
      "id": "handle-error",
      "name": "Handle Error",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [1450, 500]
    }
  ],
  "connections": {
    "Poll Every 2 Minutes": {
      "main": [
        [
          {
            "node": "Fetch Pending Notifications",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Pending Notifications": {
      "main": [
        [
          {
            "node": "Has Notifications?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Notifications?": {
      "main": [
        [],
        [
          {
            "node": "Split Notifications",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Notifications": {
      "main": [
        [
          {
            "node": "Route by Channel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route by Channel": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Slack",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Teams",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email": {
      "main": [
        [
          {
            "node": "Mark as Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Slack": {
      "main": [
        [
          {
            "node": "Mark as Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Teams": {
      "main": [
        [
          {
            "node": "Mark as Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "Handle Error"
  },
  "staticData": {
    "node:Poll Every 2 Minutes": {}
  },
  "tags": [],
  "triggerCount": 1,
  "updatedAt": "2025-12-29T00:00:00.000Z",
  "versionId": "1"
}
